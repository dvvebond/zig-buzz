{
  "name": "@buzz/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "pnpm --filter @buzz/core build && pnpm --filter @buzz/sdk build && pnpm --filter @buzz/ws-client build && pnpm --filter @buzz/pairing build && expo export --platform all --output-dir dist",
    "check": "pnpm --filter @buzz/core build && pnpm --filter @buzz/sdk build && pnpm --filter @buzz/ws-client build && pnpm --filter @buzz/pairing build && biome check . && tsc --noEmit && vitest run src",
    "test": "vitest run src",
    "native:generate": "expo prebuild",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@buzz/core": "workspace:*",
    "@buzz/pairing": "workspace:*",
    "@buzz/sdk": "workspace:*",
    "@buzz/ws-client": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^57.0.8",
    "expo-application": "^57.0.1",
    "expo-blur": "^57.0.1",
    "expo-camera": "^57.0.3",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "^57.0.7",
    "expo-crypto": "^57.0.1",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-font": "^57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "^57.0.1",
    "expo-image-picker": "^57.0.1",
    "expo-linking": "^57.0.4",
    "expo-network": "^57.0.1",
    "expo-notifications": "^57.0.4",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "^57.0.1",
    "expo-splash-screen": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-video": "^57.0.2",
    "nostr-tools": "^2.23.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.1"
  }
}
