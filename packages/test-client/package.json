{
  "name": "@buzz/test-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "buzz-test-cli-ts": "./dist/main.js",
    "buzz-mention-ts": "./dist/mention.js",
    "buzz-wamp-bench-ts": "./dist/wamp-bench.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @buzz/core build && pnpm --filter @buzz/ws-client build && tsc -p tsconfig.build.json",
    "check": "pnpm --filter @buzz/core build && pnpm --filter @buzz/ws-client build && tsc -p tsconfig.json --noEmit && vitest run src",
    "test": "vitest run src"
  },
  "dependencies": {
    "@buzz/core": "workspace:*",
    "@buzz/ws-client": "workspace:*",
    "nostr-tools": "^2.23.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.1"
  }
}
