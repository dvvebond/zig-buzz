{
  "name": "@buzz/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @buzz/core build && tsc -p tsconfig.build.json",
    "check": "pnpm --filter @buzz/core build && tsc -p tsconfig.json --noEmit && vitest run src",
    "test": "vitest run src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@buzz/core": "workspace:*",
    "blurhash": "^2.0.5",
    "file-type": "^21.0.0",
    "nostr-tools": "^2.23.3",
    "sharp": "^0.34.3",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.1"
  }
}
