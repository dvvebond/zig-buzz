{
  "name": "@buzz/remote-agent-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @buzz/core build && tsc -p tsconfig.build.json",
    "check": "pnpm --filter @buzz/core build && tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run src"
  },
  "dependencies": {
    "@buzz/core": "workspace:*",
    "nostr-tools": "^2.23.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.1"
  }
}
